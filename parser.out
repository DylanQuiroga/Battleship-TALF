    COORDINATE      reduce using rule 7 (action -> DEFENDER .)


state 9

    (8) action -> ESCANEAR .

    COORDINATE      reduce using rule 8 (action -> ESCANEAR .)


state 10

    (1) command -> action COORDINATE .

    $end            reduce using rule 1 (command -> action COORDINATE .)


state 11

    (3) command -> TABLERO bando .

    $end            reduce using rule 3 (command -> TABLERO bando .)


state 12

    (9) bando -> PROPIO .

    $end            reduce using rule 9 (bando -> PROPIO .)


state 13

