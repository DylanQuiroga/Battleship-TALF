state 3

    (2) command -> COMENZAR .

    $end            reduce using rule 2 (command -> COMENZAR .)


state 4

    (3) command -> TABLERO . bando
    (9) bando -> . PROPIO
    (10) bando -> . ENEMIGO

    PROPIO          shift and go to state 12
    ENEMIGO         shift and go to state 13

    bando                          shift and go to state 11

state 5

    (4) command -> CAMBIO .

    $end            reduce using rule 4 (command -> CAMBIO .)


state 6

    (5) command -> AYUDA .

    $end            reduce using rule 5 (command -> AYUDA .)


state 7

